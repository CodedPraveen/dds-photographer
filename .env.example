# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Private Cloudflare R2 S3-compatible storage. Keep these server-only.
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-private-r2-bucket-name
