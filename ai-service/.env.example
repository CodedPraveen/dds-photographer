# Environment settings will be defined with the service configuration.
# Do not put secrets in this example file.
APP_NAME=DDS AI Service
APP_ENV=development
AI_DATABASE_URL=postgresql://dds_ai_runtime:REPLACE_ME@db:5432/dds
AI_MIGRATOR_DATABASE_URL=postgresql://dds_ai_migrator:REPLACE_ME@db:5432/dds
AI_RUNTIME_DATABASE_ROLE=dds_ai_runtime
