{
  "name": "dds-photographer",
  "version": "0.1.0",
  "private": true,
  "description": "Premium photographer business website with private client galleries",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:foundation": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,mjs,json}\" README.md docs/design-system/design/TOKENS.md docs/design-system/development/CURRENT_TASK.md docs/design-system/production/IMPLEMENTATION_STATUS.md docs/design-system/production/IMPLEMENTED_FEATURES.md docs/design-system/production/ENVIRONMENTS.md"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^4"
  }
}
