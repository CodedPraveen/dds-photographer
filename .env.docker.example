# Required by the production app. Use a unique secret with at least 32 characters.
GALLERY_TOKEN_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
# 32-byte AES-GCM key, represented as 64 hexadecimal characters.
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Public URL used for Next.js metadata. Use your HTTPS domain outside local Docker.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Docker PostgreSQL configuration. Replace the password before use.
POSTGRES_DB=dds_photographer
POSTGRES_USER=dds_photographer
POSTGRES_PASSWORD=replace-with-a-local-database-password

# Application runtime database URL and Prisma CLI direct connection URL.
# They use the Docker service hostname, not localhost.
DATABASE_URL=postgresql://dds_photographer:replace-with-a-local-database-password@db:5432/dds_photographer?schema=public
DIRECT_URL=postgresql://dds_photographer:replace-with-a-local-database-password@db:5432/dds_photographer?schema=public

# Optional private Cloudflare R2 storage. Keep these server-only.
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-private-r2-bucket-name

# Server-only Upstash Redis TCP URL for BullMQ.
UPSTASH_REDIS_URL=rediss://default:replace-with-password@replace-with-host:6379
